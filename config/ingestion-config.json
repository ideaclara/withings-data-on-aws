{
  "version": "1.0.0",
  "providers": {
    "withings": {
      "secret_name": "prod/withings/credentials",
      "endpoints": {
        "measures": {
          "path": "/measure",
          "action": "getmeas",
          "cadence_minutes": 30,
          "category": 1,
          "description": "Body composition and vitals"
        },
        "activity": {
          "path": "/v2/measure",
          "action": "getactivity",
          "cadence_minutes": 60,
          "data_fields": "steps,distance,elevation,calories,totalcalories,hr_average,hr_min,hr_max",
          "description": "Aggregated daily activity"
        },
        "sleep": {
          "path": "/v2/sleep",
          "action": "getsummary",
          "cadence_minutes": 180,
          "data_fields": "total_timeinbed,total_sleep_time,sleep_score,hr_average,hr_min,hr_max,deepsleepduration,lightsleepduration,remsleepduration",
          "description": "Sleep metrics and stages"
        }
      }
    }
  }
}
